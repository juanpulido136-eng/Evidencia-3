<Window
    x:Class="Login.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Login">

    <Grid>
        <StackPanel Width="300" Spacing="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="Iniciar sesión" FontSize="24" FontWeight="SemiBold"/>

            <TextBox x:Name="txtUsuario"
                     Header="Usuario"
                     PlaceholderText="Escribe tu usuario"/>

            <PasswordBox x:Name="txtContrasena"
                         Header="Contraseña"
                         PlaceholderText="Escribe tu contraseña"/>

            <Button Content="Ingresar"
                    HorizontalAlignment="Stretch"
                    Click="BtnIngresar_Click"/>
        </StackPanel>
    </Grid>
</Window>